{
  "name": "@time-manage/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx/esm --watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx/esm src/db/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "@hono/zod-validator": "^0.8.0",
    "@time-manage/shared": "workspace:*",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.36.4",
    "hono": "^4.12.23",
    "nanoid": "^5.1.11",
    "pg": "^8.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3"
  }
}
